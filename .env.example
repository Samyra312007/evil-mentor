# =============================================================================
# Evil Mentor — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# All sensitive configuration is read from environment variables — no secrets
# are hardcoded in source files (Requirement 13.2).
# =============================================================================

# --- Google Gemini API (LLM) ------------------------------------------------
# API key for the Gemini API (gemini-2.0-flash model).
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- ArmorIQ SDK -------------------------------------------------------------
# Credentials for the ArmorIQ policy-gating platform.
# All agent actions (injection, scan, grading) are gated through ArmorIQ.
ARMORIQ_API_KEY=
ARMORIQ_USER_ID=
ARMORIQ_AGENT_ID=

# --- Database ----------------------------------------------------------------
# SQLite connection URL for the MVP. Swap to a PostgreSQL URL for production.
# Example PostgreSQL: postgresql://user:password@localhost:5432/evil_mentor
DATABASE_URL=sqlite:///evil_mentor.db

# --- Training Window ---------------------------------------------------------
# Hours (0-23, UTC) during which training sessions are allowed.
# Requests outside this window are rejected (Requirement 5.6).
TRAINING_START_HOUR=9
TRAINING_END_HOUR=18

# --- Rate Limiting -----------------------------------------------------------
# Maximum number of training sessions a single user can start per day.
MAX_INJECTIONS_PER_DAY=10

# --- Branch Protection -------------------------------------------------------
# Comma-separated list of branch names that are protected from injection.
# Injection requests targeting these branches are rejected (Requirement 4.3).
BLOCKED_BRANCHES=main,master,production
